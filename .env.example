# Copy to .env and fill in the empty values. Never commit .env.
# Empty values are treated as "not set"; the app tells you exactly which one is missing.

# --- Runtime ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL (used by docker compose AND by the apps) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=content
# required: pick any strong password
POSTGRES_PASSWORD=
POSTGRES_DB=content

# --- Object storage ---
# local = files in LOCAL_STORAGE_DIR; s3 = S3-compatible storage from docker compose
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=data/storage
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=content
# required when STORAGE_DRIVER=s3: any strings; docker compose creates this identity
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Safety switches ---
# Images / Instagram providers. mock = no external calls (default). real = not implemented yet (stages 3-4)
PROVIDERS_MODE=mock
DRY_RUN=true
# Auto-publishing is not part of this setup; keep false.
PUBLISH_ENABLED=false

# --- API and web panel ---
# Loopback only (127.0.0.1, localhost or ::1): the panel is never exposed to the network.
API_HOST=127.0.0.1
API_PORT=3000
# required for pnpm dev:api / start:api: run `pnpm panel:password` and paste the printed line here.
# Only the scrypt hash is stored, never the password.
PANEL_PASSWORD_HASH=
# Log out after this many minutes without activity, and in any case after this many hours.
PANEL_SESSION_IDLE_MINUTES=30
PANEL_SESSION_MAX_HOURS=12
# After this many wrong passwords in a row the login is locked for PANEL_LOGIN_LOCK_MINUTES.
PANEL_LOGIN_MAX_ATTEMPTS=5
PANEL_LOGIN_LOCK_MINUTES=5

# --- Time zone for daily/monthly budgets and reminders (IANA name) ---
APP_TIMEZONE=Europe/Moscow

# --- LLM (Anthropic) ---
# mock = canned answers, no API calls, $0 (default)
# anthropic = Claude API directly; tokenharbor = Token Harbor gateway (Anthropic-compatible /v1/messages)
LLM_PROVIDER=mock
# required when LLM_PROVIDER=anthropic and for pnpm smoke:llm
ANTHROPIC_API_KEY=
LLM_MODEL_CEO=claude-opus-5-5
LLM_MODEL_CRITIC=claude-opus-5-5
LLM_MODEL_WORKER=claude-sonnet-5-5
LLM_MODEL_CLASSIFIER=claude-haiku-5-5
# per HTTP request; the SDK retries 429/5xx/network errors LLM_MAX_RETRIES times
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=3
# store full prompt/response text in llm_calls (false = metadata only)
LLM_STORE_FULL_TEXT=true
# on a safety refusal, let the API re-run the request on Anthropic's recommended fallback model
# (Anthropic only; always off for tokenharbor)
LLM_REFUSAL_FALLBACK=true
# Price list. Leave commented: it is chosen by LLM_PROVIDER
# (config/model-pricing.json or config/model-pricing.tokenharbor.json).
# MODEL_PRICING_FILE=
# Budgets count token cost x this factor (protects limits if provider token counts drift).
LLM_COST_SAFETY_FACTOR=1.2
# true = output_config.format; false = JSON schema in the system prompt + Zod validation
LLM_STRUCTURED_OUTPUTS=true
# Client-side request limits, 0 = off
LLM_RATE_LIMIT_PER_MINUTE=0
LLM_RATE_LIMIT_PER_HOUR=0

# --- Token Harbor gateway (when LLM_PROVIDER=tokenharbor) ---
# Recommended values for the free account:
#   LLM_PROVIDER=tokenharbor
#   LLM_MODEL_CEO=claude-haiku-5.5:free
#   LLM_MODEL_CRITIC=claude-haiku-5.5:free
#   LLM_MODEL_WORKER=claude-haiku-5.5:free
#   LLM_MODEL_CLASSIFIER=claude-haiku-5.5:free
#   LLM_STRUCTURED_OUTPUTS=false
#   LLM_RATE_LIMIT_PER_MINUTE=60
#   LLM_RATE_LIMIT_PER_HOUR=1800
TOKENHARBOR_API_KEY=
# without /v1 — the SDK appends /v1/messages
TOKENHARBOR_BASE_URL=https://tokenharbor.ai
# x-api-key | bearer
TOKENHARBOR_AUTH=x-api-key

# --- Budgets (USD). Warning at BUDGET_WARN_RATIO, pause at 100% until you approve more ---
BUDGET_DAILY_USD=5
BUDGET_MONTHLY_USD=50
BUDGET_TASK_USD=2
BUDGET_WARN_RATIO=0.8

# --- Queue / reliability ---
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_JOB_TIMEOUT_SECONDS=900
RUN_STALE_AFTER_SECONDS=900
APPROVAL_REMINDER_HOURS=12

# --- Telegram bot ---
# token from @BotFather
TELEGRAM_BOT_TOKEN=
# your numeric Telegram user id (e.g. from @userinfobot); the bot ignores everyone else
TELEGRAM_OWNER_ID=

# --- Brand profile and export ---
BRAND_PROFILE_FILE=config/brands/default.yaml
EXPORT_DIR=data/exports
