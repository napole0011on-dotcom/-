# Copy to .env and fill in the empty values. Never commit .env.
# Empty values are treated as "not set"; the app tells you exactly which one is missing.

# --- Runtime ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL (used by docker compose AND by the apps) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=content
# required: pick any strong password
POSTGRES_PASSWORD=
POSTGRES_DB=content

# --- Object storage ---
# local = files in LOCAL_STORAGE_DIR; s3 = S3-compatible storage from docker compose
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=data/storage
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=content
# required when STORAGE_DRIVER=s3: any strings; docker compose creates this identity
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Safety switches ---
# mock = no external calls (default). real = real adapters (not implemented yet)
PROVIDERS_MODE=mock
DRY_RUN=true
# Auto-publishing is not part of this setup; keep false.
PUBLISH_ENABLED=false

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
